# ==============================================================================
# Core Application & Security Settings
# ==============================================================================
APP_ENV=development
APP_NAME=ai-sdlc-automation
APP_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-or-base64-string
LOG_LEVEL=INFO
LOG_FORMAT=json

# Single-Operator Authentication (Bootstrap Credentials)
OPERATOR_USERNAME=admin
# Generate hash via: python -c "from app.core.security import hash_password; print(hash_password('your-password'))"
OPERATOR_PASSWORD_HASH=$2b$12$EixZaYVK1fsbw1ZfbX3OXePaWxn96p36WQoeG6Lruj3vjPGga31lW
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application-Level Credential Encryption (Comma-separated Fernet keys; first is primary)
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEYS=7_wB9x_0yZ1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p8=

# ==============================================================================
# Infrastructure (PostgreSQL, Redis, Celery, Qdrant)
# ==============================================================================
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_sdlc
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ==============================================================================
# LLM, Embeddings, and Tracing (LangSmith Opt-In)
# ==============================================================================
LLM_PROVIDER=openai
LLM_MODEL_DEFAULT=gpt-4o
LLM_API_KEY=
LLM_BASE_URL=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-sdlc-automation

# ==============================================================================
# GitHub Integration
# ==============================================================================
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_PAT_FALLBACK_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ==============================================================================
# Workspaces, Artifacts, and Sandbox Runner
# ==============================================================================
WORKSPACE_ROOT_DIR=./.workspaces
WORKSPACE_DISK_QUOTA_MB=2048
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_PATH=./.artifacts

SANDBOX_RUNNER_URL=http://localhost:8001
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_CPU_LIMIT=2.0
SANDBOX_MEMORY_LIMIT_MB=2048
SANDBOX_DISK_LIMIT_MB=1024
SANDBOX_PIDS_LIMIT=256
SANDBOX_TEST_TIMEOUT_SECONDS=600
SANDBOX_PIP_INDEX_URL=https://pypi.org/simple

# ==============================================================================
# Default Operational Budgets and Safety Limits
# ==============================================================================
MAX_CORRECTION_LOOPS_PER_FAILURE=3
MAX_CORRECTION_LOOPS_PER_WORKFLOW=5
MAX_LLM_CALLS_PER_WORKFLOW=150
MAX_FILES_PER_PATCH=15
MAX_LINES_PER_PATCH=1500
MAX_RETRIEVAL_TOKENS=24000
MAX_RETRIEVAL_FILES=40
MAX_REPO_SIZE_MB=500
MAX_REPO_PYTHON_FILES=20000
WORKFLOW_TIMEOUT_SECONDS=7200